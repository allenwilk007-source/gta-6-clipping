# Twitch app credentials — https://dev.twitch.tv/console/apps
# Register an app (OAuth redirect http://localhost, category "Application Integration")
# and paste the Client ID and a generated Client Secret here.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Chat-only mode. Chat is anonymous and unmetered, so moment detection runs
# with no credentials at all - and chat is the only signal that can fire
# BEFORE anybody has clipped. What it cannot do is measure saturation: with no
# API there is no way to count who already has a moment.
#
# Helix is the only way to ask "who is live in this category", so without it
# the channels have to be named. Unset uses a built-in starting list; set it to
# nothing at all to disable chat-only entirely.
# WATCH_CHANNELS=xqc,kaicenat,caseoh_

# Seconds between chat-only detection passes. A bucket closes every 10s and
# being first is the whole point of this path, so it polls faster than clips.
# CHAT_POLL_SECONDS=10

# Which Twitch categories to watch and clip, comma-separated, spelled exactly
# as Twitch spells them (the same names are matched against a VOD's game
# chapters, which is how chat-only mode tells GTA from Fortnite from anything
# else). Default: Grand Theft Auto VI,Fortnite
GAMES=Grand Theft Auto VI,Fortnite
# Older one-game setting. Only used when GAMES is unset.
GAME_NAME=
# Pins ONE category by id and overrides GAMES.
GAME_ID=

# How far back to look for clips, in minutes. Shorter = fresher and cheaper,
# but moments drop off the feed sooner.
CLIP_WINDOW_MINUTES=25

# Seconds between clip polls. 30 is responsive without burning rate limit.
CLIP_POLL_SECONDS=30

# Max pages of 100 clips per poll. Raise if the feed reports truncation.
CLIP_MAX_PAGES=30

# Seconds between live-channel refreshes (also updates the chat watch list).
STREAM_POLL_SECONDS=120

# Clips within this many seconds of each other count as the same moment.
CLUSTER_GAP_SECONDS=30

# Deep links start this many seconds early, because chat reacts after the
# thing happens and so do clippers.
LEAD_IN_SECONDS=20

# How many top channels to watch chat on. Each socket carries 18 channels.
CHAT_CHANNELS=80

# Set to false to run on clip data alone (no IRC connections).
CHAT_ENABLED=true

# How loud a 10-second bucket must be before it can count as a spike. Low on
# purpose: a high floor only admits channels so big their moments are flooded
# the moment they happen, which is the opposite of what this feed is for.
CHAT_FLOOR_MESSAGES=8
CHAT_MIN_RISE=1.5
CHAT_SPIKE_Z=3


PORT=3000

# Which addresses the dashboard answers on. Unset means this machine only,
# which is what you want: the page flips the upload switches and spends the
# quota on the accounts you connected, so anyone who can reach it is you.
# Set HOST=0.0.0.0 to reach it from your phone on the same Wi-Fi - and then
# DASHBOARD_PASSWORD is required, or it refuses to start.
# HOST=0.0.0.0

# The password for the dashboard. Any username, this password. Unset is fine
# while it is on this machine only; required the moment HOST is set or the
# port is behind a tunnel.
# DASHBOARD_PASSWORD=

# Extra names the dashboard will answer to. A tunnel (ngrok, Cloudflare) or a
# reverse proxy arrives carrying its own hostname, and anything not listed
# here is turned away - which is what stops a domain pointed at your machine
# from reading the page. Comma-separated. Setting it requires
# DASHBOARD_PASSWORD, because something outside this machine is reaching in.
# DASHBOARD_HOSTS=your-tunnel.ngrok-free.dev

# ---------- local clip extraction ----------
# Needs yt-dlp and ffmpeg on the machine:  python -m pip install yt-dlp
# (streamlink is NOT used — see the README for why it cannot work here.)

# How much of the VOD to take around a moment, in seconds. Lopsided on
# purpose: chat and clippers both react AFTER the thing happens, so the
# moment's timestamp is the tail of it and the cause sits in the pre-roll.
CLIP_PRE=25
CLIP_POST=5

# Where the mp4s land, relative to the repo. Already gitignored.
CLIP_DIR=clips

# Height cap (1080 / 720 / 480), or "source" for whatever Twitch has, or any
# yt-dlp format string if you want to be precise.
CLIP_QUALITY=1080

# Simultaneous cuts. Each one is an ffmpeg re-encode, so more than 2 just
# makes the clip someone is waiting on slower.
CLIP_CONCURRENCY=2

# How to invoke yt-dlp. The module form is the default because the console
# script shim fails on some Windows installs.
YTDLP_CMD=python -m yt_dlp

# ---------- detection store ----------
# Every moment, clip and poll is written here so outcomes can be checked hours
# later and `npm run eval` can say whether the ranking actually works.
# node:sqlite is in the Node standard library — no dependency.
STORE_ENABLED=true
STORE_PATH=data/feed.db

# How often to look back at older moments and record what became of them.
OUTCOME_POLL_SECONDS=60
OUTCOME_BATCH=20

# How long to keep the per-poll observation rows. Only those are pruned; the
# moments, clips and outcomes behind the clipper index are kept, because that
# history cannot be re-collected after the fact.
STORE_PRUNE_DAYS=14

# --- Channel automation ---------------------------------------------------
# Detects, cuts, captions and renders 9:16 shorts with no clicks. Channels and
# the on/off switch live in the page (saved to data/automation.json); this
# starts a fresh install switched on. `npm run auto` is always on.
# Each short lands here as an .mp4 plus a .txt of post copy (caption, credit,
# link, tags). Nothing is ever uploaded or posted: what you post, you post.
AUTOCLIP=off
AUTOCLIP_DIR=clips/ready
# The real control knob: how many shorts an hour, overall and per channel.
# This limits volume, not load (two renders at once does that); 60 an hour fits.
AUTOCLIP_PER_HOUR=60
AUTOCLIP_PER_CHANNEL_PER_HOUR=6
# Once the hour is full, a moment that beats everything cut this hour is cut
# anyway, up to this many extra an hour: the cap is first-come, and the best
# moment of the hour can arrive after it fills.
AUTOCLIP_BEATS_HOUR_PER_HOUR=5
AUTOCLIP_MAX_PER_POLL=4
# Feed states worth cutting. A flooded moment is already on everyone's feed.
AUTOCLIP_STATES=early,fresh
# 0 on purpose. The opportunity scale is uncalibrated until `npm run eval`
# has enough outcomes to say what a good score is; a threshold before then
# would be a guess dressed as a setting.
AUTOCLIP_MIN_SCORE=0
# Wait this long after the cut window ends before cutting. Measured: a live,
# still-recording archive held full footage 15s behind the live edge.
AUTOCLIP_SETTLE_SECONDS=30
# Older than this and someone else has had time to post it.
AUTOCLIP_MAX_AGE_MINUTES=20
# Two moments this close on the same VOD are the same moment.
AUTOCLIP_DEDUPE_SECONDS=45

# reel: black canvas, white hook directly on top of the picture (the default).
# blur: a blurred copy of the frame fills the canvas, outlined caption above.
SHORTS_STYLE=reel
# Font for all on-screen text, by family name, from SHORTS_FONTS_DIR plus the
# system's. Empty = Segoe UI (reel) or Segoe UI Black (blur) on Windows, DejaVu
# Sans elsewhere. Emoji fall back to the system emoji font on their own.
SHORTS_FONT_NAME=
SHORTS_FONTS_DIR=
# Empty = tags for each clip's own game (#gta6... or #fortnite...). Set it to
# use the same tags on everything.
SHORTS_HASHTAGS=
# Integrated loudness target. Platforms normalise near -14 LUFS.
SHORTS_LUFS=-14

# Word-timed subtitles of what is said, with the spoken word highlighted, and
# titles quoting it. Needs faster-whisper and its model, fetched once:
#   python -c "from faster_whisper import WhisperModel; WhisperModel('base.en')"
# Speech the model is unsure of (another language, mostly) gets no subtitles.
SHORTS_SUBTITLES=on
SUBTITLES_MODEL=base.en
PYTHON_CMD=python
# Slurs are always masked. This masks ordinary swearing too; off to keep it.
SHORTS_CENSOR=on

# The streamer's webcam across the top, when one is found in the clip. Needs
# models/face_detection_yunet_2023mar.onnx (see the README).
SHORTS_FACECAM=on

# The engagement meter: under KEEP a short is redone from a wider cut; under
# FLOOR after that it is flagged weak. Calibrated against hand ratings.
ENGAGEMENT_KEEP=50
ENGAGEMENT_FLOOR=30

# Background music under each short, from your own royalty-free tracks in
# SHORTS_MUSIC_DIR (see music/README.md). Switch it in the page; this sets the
# starting position for a fresh install and for npm run auto.
SHORTS_MUSIC=off
SHORTS_MUSIC_DIR=music
SHORTS_MUSIC_VOLUME=0.12

# Shorts you never clicked Download on are deleted from clips/ready this many
# hours after they were made, with their post copy. Downloaded ones are kept
# (listed in data/kept.json), and so is one mid-upload. 0 keeps everything.
SHORTS_KEEP_HOURS=6

# Live recording, for channels with no VOD to cut from (ishowspeed, and
# channels whose VODs are subscriber-only). The last RECORD_KEEP_SECONDS of
# each stream, at up to RECORD_QUALITY lines, for at most RECORD_MAX channels.
RECORDING=on
RECORD_MAX=4
RECORD_KEEP_SECONDS=600
RECORD_QUALITY=720

# --- Posting: your own developer apps (see docs/posting-setup.md) ----------
# Keys only ever go here, never into a chat. Start with YouTube.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Auto upload (switch it in the page: Off / Dry run / On). Each upload costs
# 1,600 of YouTube's default 10,000 daily units, so 5 a day leaves room for a
# failed attempt. Evenly spaced; the best-scoring shorts go first.
YOUTUBE_PER_DAY=5
YOUTUBE_SPACING_MINUTES=180
# public | unlisted | private. Google keeps uploads from an unaudited project
# private whatever this says, until its audit passes.
YOUTUBE_PRIVACY=public
# Which of the GAMES above this channel is for, comma-separated and spelled
# the same way. Unset = everything the feed watches, which is what a single
# channel posting all of it wants. Set it when the channel is about one game:
# a Tarkov channel fed GTA clips is worse than one posting nothing. It only
# NARROWS what GAMES watches — a game missing from GAMES reaches no queue
# whatever this says.
# YOUTUBE_GAMES=Escape from Tarkov
# TikTok. developers.tiktok.com -> your app -> Login Kit + Content Posting.
# Scopes needed: user.info.basic, user.info.stats, video.list, video.upload.
#
# An upload arrives as a DRAFT in your TikTok inbox: you open the app, write
# the caption and post it. Posting straight to the profile needs the
# video.publish scope and TikTok's audit; until that passes TikTok restricts
# everything an unaudited client posts to private viewing. The caption this
# tool would have written is logged for you to paste.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# TikTok allows at most 5 pending inbox shares in any rolling 24 hours, so
# going above 5 only earns a refusal. 24h over 5 is a little under 5 hours.
TIKTOK_PER_DAY=5
TIKTOK_SPACING_MINUTES=280
# As YOUTUBE_GAMES, for TikTok.
# TIKTOK_GAMES=
# Instagram. A professional (Business or Creator) account LINKED TO A FACEBOOK
# PAGE you administer, plus a Meta app using "Instagram API with Facebook
# Login". The Page is not optional: the other flavour ("Instagram API with
# Instagram Login") publishes only from a public `video_url` that Meta's
# servers fetch, and nothing here is on the public internet.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Instagram allows 50 published posts in a moving 24 hours; 45 leaves room for
# a failed attempt. Worth saying plainly: 45 Reels a day is a great many, and
# the API permitting it is not the same as it being good for the account.
# Lower this if reach matters more than volume.
INSTAGRAM_PER_DAY=45
INSTAGRAM_SPACING_MINUTES=32
# Whether a Reel also lands on the profile grid. false is the quieter choice.
INSTAGRAM_SHARE_TO_FEED=true
# As YOUTUBE_GAMES, for Instagram.
# INSTAGRAM_GAMES=
